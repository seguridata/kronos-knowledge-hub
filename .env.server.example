# Plantilla de entorno para docker-compose.server.yml.
# Copiar a `.env` y completar. Nunca commitear el `.env` real.

# --- Generados por quien despliega (openssl rand -hex 32) ---
# No cambiar APP_SECRET después del primer arranque.
APP_SECRET=GENERAR_CON_openssl_rand_hex_32
# Hexadecimal a propósito: va dentro de una URL de conexión.
POSTGRES_PASSWORD=GENERAR_CON_openssl_rand_hex_32

# --- Dominio (por confirmar) ---
# Debe coincidir exactamente con el dominio HTTPS que sirve Caddy.
APP_URL=https://kronos.example.com

# --- Correo (aporta el usuario) ---
# Opciones: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=kronos@example.com
MAIL_FROM_NAME=Seguridata
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Si se usa Postmark en lugar de SMTP:
# POSTMARK_TOKEN=

# --- Opcionales (valores por defecto razonables) ---
POSTGRES_USER=kronos
POSTGRES_DB=kronos
JWT_TOKEN_EXPIRES_IN=30d
# Opciones: local | s3 | azure (con local se usa el volumen kronos_storage)
STORAGE_DRIVER=local
# Por defecto: 50mb
FILE_UPLOAD_SIZE_LIMIT=
# Servidor drawio y Gotenberg propios (vacío para no usarlos)
DRAWIO_URL=
GOTENBERG_URL=
DISABLE_TELEMETRY=true
# Imagen a usar (por defecto, la publicada en GHCR)
# KRONOS_IMAGE=ghcr.io/seguridata/kronos-knowledge-hub:latest
